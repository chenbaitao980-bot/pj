    "dsh-plugin",
    "dsh-plugins",
    "agent-skills",
    "skill-pack",
    "trellis",
    "deepseek-harness"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs"
  }
