{
  "name": "dsh-plugin-scope",
  "version": "1.1.0",
  "description": "按工作区开关 trellis / gitnexus / codegraph：插件页「按工作区」Tab 内嵌本地控制面板，另提供 /pluginscope 命令读写 <工作区>/.dsh/plugins.json",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "workspace",
    "plugin-scope",
    "deepseek-harness"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  }
}
