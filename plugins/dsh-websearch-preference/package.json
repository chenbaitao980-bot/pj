{
  "name": "@local/dsh-websearch-preference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "装有 dsh-tool-websearch 的部署里，让模型优先用 web_search_meta，空结果/失败时才回退内置 web_search。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
