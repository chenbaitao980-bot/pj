{
  "name": "@local/dsh-cc-touch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Claude Code-style sidebar feel: a two-step hover alpha ramp and a 120ms ease-out-snap transition on rows and icon buttons.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
