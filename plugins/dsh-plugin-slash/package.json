{
  "name": "@local/dsh-plugin-slash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "在会话输入框的 / 菜单里增加「插件」分组：列出已启用插件及说明，选中后把插件名插入草稿。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-input-trigger"]
    }
  }
}
