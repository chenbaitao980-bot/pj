{
  "name": "@local/dsh-todo-nudge",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "任务守护：让模型用 todo_write 维护清单；模型不写或久不更新时，用会话自己的主模型按实际动作规划、实时审计和调整任务，回合结束逐条收口未完成项，必要时追问一次。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
